# Local development uses a SQLite file. In production use a Postgres URL (Neon, Supabase, …).
DATABASE_URL=file:./credence.db
# Long random string — generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Public site address (used for absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used only by `npm run seed` to create the first admin login
SEED_ADMIN_EMAIL=admin@credence.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Production only ---
# Optional: file storage for uploads (Cloudflare R2 / S3). Without it uploads are saved to ./media (fine locally, not on Vercel).
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: e-mail alert for every new enquiry (https://resend.com)
# RESEND_API_KEY=
# LEADS_FROM=Credence <leads@yourdomain.com>
# LEADS_TO=sales@yourdomain.com
